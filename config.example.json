  "memoryStoragePath": null,
  "ragStoragePath": null,
  "cacheStoragePath": null,
  "promptsStoragePath": null,

  "_comment_tuning": "Optional: Fine-tuning parameters",
  "maxMemoryAge": 24,
  "maxCacheAge": 7,
  "ragMinSimilarity": 0.6
}
